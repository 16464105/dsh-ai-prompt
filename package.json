{
  "name": "dsh-prompt-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "提示词库：把常用提示词存成斜杠命令，在聊天输入框输入 / 即可快速选择并发送。Prompt library as slash commands for DeepSeek Harness.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./library": {
      "default": "./lib/library.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:host": "node --test test/host.test.js",
    "test:library": "node --test test/library.test.js"
  }
}
